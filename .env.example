# ---------- Obligatorios ----------

# Token del bot. Te lo da @BotFather en Telegram al crear el bot.
TELEGRAM_TOKEN=

# Clave de la API de Anthropic (console.anthropic.com > API Keys).
ANTHROPIC_API_KEY=

# Tu ID de Telegram. Déjalo vacío la primera vez: escríbele /start al bot y te lo dice.
# Con este número puesto, el bot solo te responde a ti.
TELEGRAM_USER_ID=

# ---------- Opcionales ----------

# Cómo te llama el asistente.
NOMBRE_USUARIO=Manuelle

# Modelo de Claude. Haiku es el más económico; Sonnet entiende mejor pedidos enredados.
CLAUDE_MODELO=claude-haiku-5-5

ZONA_HORARIA=America/Bogota

# Hora del resumen diario (24 h). Pon off para no recibirlo.
RESUMEN_HORA=07:00

# Modelo para notas de voz: small (recomendado), base (más liviano) u off (sin notas de voz).
WHISPER_MODELO=small
